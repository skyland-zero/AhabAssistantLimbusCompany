    "execution.pause": {"mutating": true, "params": "ExecutionControlParams", "result": "ExecutionStatus"},
    "execution.resume": {"mutating": true, "params": "ExecutionControlParams", "result": "ExecutionStatus"},
    "team.list": {"mutating": false, "params": "none", "result": "Team[]"},
