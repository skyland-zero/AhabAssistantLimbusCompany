  "errors": {
    "-32700": {"name": "PARSE_ERROR", "retryable": false},
    "-32600": {"name": "INVALID_REQUEST", "retryable": false},
    "-32601": {"name": "METHOD_NOT_FOUND", "retryable": false},
    "-32602": {"name": "INVALID_PARAMS", "retryable": false},
    "-32603": {"name": "INVALID_RESPONSE", "retryable": false},
    "-32000": {"name": "INTERNAL_ERROR", "retryable": true},
    "-32001": {"name": "BACKEND_UNAVAILABLE", "retryable": true},
    "-32010": {"name": "EXECUTION_BUSY", "retryable": false},
    "-32011": {"name": "INVALID_EXECUTION_STATE", "retryable": false},
    "-32013": {"name": "STALE_RUN", "retryable": false},
    "-32020": {"name": "DEVICE_ERROR", "retryable": false},
    "-32030": {"name": "QUEUE_FULL", "retryable": true}
