    "app.checkUpdate": {"mutating": false, "params": "none", "result": "UpdateCheck"},
    "app.shutdown": {"mutating": true, "params": "none", "result": "boolean"},
    "app.diagnose": {"mutating": false, "params": "none", "result": "BackendDiagnostics"},
    "stats.getSummary": {"mutating": false, "params": "none", "result": "ExecutionSummary"},
