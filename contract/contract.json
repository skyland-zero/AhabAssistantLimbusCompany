    "tasks.getConfig": {"mutating": false, "params": "none", "result": "TasksConfig"},
    "tasks.setConfig": {"mutating": true, "params": "TasksConfig", "result": "boolean"},
    "execution.getState": {"mutating": false, "params": "none", "result": "ExecutionStatus"},
    "execution.start": {"mutating": true, "params": "ExecutionStartParams", "result": "ExecutionStartResult"},
