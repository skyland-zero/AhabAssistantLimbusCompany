    "sinner.list": {"mutating": false, "params": "none", "result": "Sinner[]"},
    "themePack.list": {"mutating": false, "params": "none", "result": "ThemePack[]"},
    "themePack.updateAll": {"mutating": true, "params": "ThemePackUpdateParams", "result": "boolean"},
    "themePack.resetWeights": {"mutating": true, "params": "none", "result": "boolean"},
    "resource.status": {"mutating": false, "params": "none", "result": "ResourceStatus"},
    "resource.checkUpdate": {"mutating": false, "params": "none", "result": "ResourceStatus"},
    "resource.sync.start": {"mutating": true, "params": "ResourceSyncParams", "result": "ResourceSyncResult"},
    "tool.start": {"mutating": true, "params": "ToolStartParams", "result": "boolean"},
    "tool.stop": {"mutating": true, "params": "ToolStopParams", "result": "boolean"},
    "tool.screenshot": {"mutating": true, "params": "ToolScreenshotParams", "result": "boolean"},
    "tool.resolution.set": {"mutating": true, "params": "ToolResolutionParams", "result": "boolean"},
    "tool.resolution.reset": {"mutating": true, "params": "ToolResolutionResetParams", "result": "boolean"},
    "hotkey.get": {"mutating": false, "params": "none", "result": "HotkeySettings"},
    "hotkey.set": {"mutating": true, "params": "HotkeyUpdate", "result": "HotkeySettings"},
    "systemSettings.get": {"mutating": false, "params": "none", "result": "SystemSettings"},
    "systemSettings.set": {"mutating": true, "params": "SystemSettingsUpdate", "result": "SystemSettings"},
    "notification.test": {"mutating": false, "params": "NotificationTestParams", "result": "boolean"},
    "preview.setEnabled": {"mutating": true, "params": "PreviewParams", "result": "PreviewStatus"},
    "device.list": {"mutating": false, "params": "none", "result": "Device[]"},
    "device.connect": {"mutating": true, "params": "DeviceIdParams", "result": "Device"},
    "device.disconnect": {"mutating": true, "params": "none", "result": "DeviceStatus"}
  },
  "events": {
    "screenshot.frame": {"payload": "ScreenshotFrame"},
    "preview.status": {"payload": "PreviewStatus"},
    "execution.status": {"payload": "ExecutionStatus"},
    "execution.stats": {"payload": "ExecutionStats"},
    "execution.mirrorProgress": {"payload": "MirrorProgress"},
    "execution.mirrorFloor": {"payload": "MirrorFloor"},
    "execution.taskStarted": {"payload": "TaskLifecycle"},
    "execution.taskCompleted": {"payload": "TaskLifecycle"},
    "execution.configDelta": {"payload": "ConfigDelta"},
    "execution.resourceCreated": {"payload": "ResourceEvent"},
    "execution.resourceReleased": {"payload": "ResourceEvent"},
    "execution.runnerReady": {"payload": "RunnerReady"},
    "execution.finished": {"payload": "RunnerFinished"},
    "execution.error": {"payload": "RunnerError"},
    "execution.afterCompletionRequested": {"payload": "AfterCompletion"},
    "tool.status": {"payload": "ToolStatus"},
    "device.status": {"payload": "DeviceStatus"},
    "resource.sync.progress": {"payload": "ResourceSyncProgress"},
    "log.entry": {"payload": "LogEntry"},
    "app.notice": {"payload": "Notice"},
