{
  "name": "AALC.nsh",
  "id": "com.skyland-zero.aalc.nsh",
  "version": "0.0.1",
  "build": 1,
  "rust": "native",
  "theme": "theme.json",
  "icon": "assets/app-icon.png",
  "appearance": "system",
  "singleInstance": true,
  "window": {
    "title": "AALC.nsh",
    "defaultSize": {
      "width": 820,
      "height": 680
    },
    "minSize": {
      "width": 800,
      "height": 560
    },
    "titleBar": {
      "style": "hidden"
    },
    "frame": "none",
    "transparent": true,
    "shadow": false
  },
  "capabilities": {
    "network": {
      "hosts": [
        "127.0.0.1",
        "localhost"
      ]
    },
    "openUrl": {
      "schemes": ["https"]
    },
    "statusBar": true,
    "windows": true,
    "clipboard": true
  }
}
