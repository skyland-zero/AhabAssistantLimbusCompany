{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AhabAssistantUI",
  "version": "0.1.0",
  "identifier": "com.kiyi671.ahab-ui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ahab Assistant · Limbus Company",
        "width": 900,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
