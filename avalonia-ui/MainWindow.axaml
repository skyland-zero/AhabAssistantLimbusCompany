<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AhabAssistant.Avalonia.MainWindow"
        Title="Ahab Assistant · Limbus Company"
        Width="1180" Height="720" MinWidth="960" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Panel Background="{DynamicResource BgBrush}">
        <Grid RowDefinitions="40,36,*">
            <!-- ==================== 标题栏 ==================== -->
            <Grid Grid.Row="0" Background="{DynamicResource CardBrush}" Name="TitleBarRoot">
                <Grid.Styles>
                    <Style Selector="Border#DragRegion">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Grid.Styles>
                <Grid ColumnDefinitions="*,Auto">
                    <Border Name="DragRegion" Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="8">
                            <Image Source="avares://AhabAssistant.Avalonia/Assets/limbus_title_banner.png"
                                   Height="20" Stretch="Uniform" />
                            <TextBlock Text="· Ahab Assistant"
                                       FontSize="11"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource MutedFgBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="MinBtn" Classes="app-btn titlebar-btn" Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets" ToolTip.Tip="最小化" Click="OnMinimize" />
                        <Button Name="MaxBtn" Classes="app-btn titlebar-btn" Content="&#xE922;"
                                FontFamily="Segoe MDL2 Assets" ToolTip.Tip="最大化" Click="OnToggleMaximize" />
                        <Button Name="CloseBtn" Classes="app-btn titlebar-btn titlebar-close" Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets" ToolTip.Tip="关闭" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ==================== 导航 Tab 栏 ==================== -->
            <Border Grid.Row="1" Background="{DynamicResource TabBarBrush}">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="nav-tab" Name="NavHome" Click="OnNavClick" Tag="home">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="⌂" FontSize="13" />
                                <TextBlock Text="主控台" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav-tab" Name="NavTeams" Click="OnNavClick" Tag="teams">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="👥" FontSize="11" />
                                <TextBlock Text="队伍管理" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav-tab" Name="NavThemes" Click="OnNavClick" Tag="themes">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🎨" FontSize="11" />
                                <TextBlock Text="主题包" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav-tab" Name="NavToolbox" Click="OnNavClick" Tag="toolbox">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔧" FontSize="11" />
                                <TextBlock Text="工具箱" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav-tab" Name="NavResources" Click="OnNavClick" Tag="resources">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📦" FontSize="11" />
                                <TextBlock Text="资源中心" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav-tab" Name="NavHelp" Click="OnNavClick" Tag="help">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="❓" FontSize="11" />
                                <TextBlock Text="帮助" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="app-btn icon-btn" Name="ThemeToggleBtn" ToolTip.Tip="主题模式"
                                Foreground="{DynamicResource MutedFgBrush}" Click="OnToggleTheme">
                            <TextBlock Name="ThemeIcon" Text="🖥" FontSize="12" />
                        </Button>
                        <Button Classes="app-btn icon-btn" Name="SettingsBtn" ToolTip.Tip="设置"
                                Click="OnNavClick" Tag="settings">
                            <TextBlock Text="⚙" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 页面内容 ==================== -->
            <ContentControl Grid.Row="2" Name="PageHost" Margin="0" />
        </Grid>

        <!-- ==================== Toast 顶部居中浮层 ==================== -->
        <Border Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,56,0,0"
                CornerRadius="8" Padding="14,9" IsHitTestVisible="False" IsVisible="False"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                BoxShadow="0 4 16 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Name="ToastIcon" Text="✅" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Name="ToastText" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Panel>
</Window>
