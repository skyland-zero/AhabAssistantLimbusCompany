<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    正式 Windows 发布配置：
    - 固定 win-x64，避免因调用方参数不同产生不同产物
    - Native AOT 自包含发布，不要求目标机器安装 .NET
    - 默认不把 PDB 留在用户发布目录；传入 KeepPublishSymbols=true 可保留
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>

    <!-- 先生成符号，便于需要时单独保留；用户包在 Publish 后清理 PDB。 -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <KeepPublishSymbols Condition="'$(KeepPublishSymbols)' == ''">false</KeepPublishSymbols>
  </PropertyGroup>

  <!--
    Native AOT 仍可能携带应用及原生依赖的 PDB。
    PDB 不参与运行，因此默认从最终 publish 目录删除，避免用户包膨胀。
  -->
  <Target Name="RemovePublishSymbols"
          AfterTargets="Publish"
          Condition="'$(KeepPublishSymbols)' != 'true'">
    <ItemGroup>
      <_PublishPdbFiles Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbFiles)" />
  </Target>
</Project>
