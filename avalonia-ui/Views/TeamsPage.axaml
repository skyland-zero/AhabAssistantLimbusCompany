<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AhabAssistant.Avalonia.ViewModels"
             xmlns:c="clr-namespace:AhabAssistant.Avalonia.Converters"
             x:Class="AhabAssistant.Avalonia.Views.TeamsPage"
             x:DataType="vm:TeamsViewModel">
    <UserControl.Resources>
        <c:NullToVis x:Key="NullVis" />
        <c:SchemeIcon x:Key="SchemeIcon" />
        <c:StringEqualsConv x:Key="StrEq" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部栏：用途分类切换 Tab + 新建队伍按钮 -->
        <Border Grid.Row="0" Padding="16,8">
            <Border.Background>
                <SolidColorBrush Color="#30FFFFFF" />
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="app-btn seg" Height="28" Click="TabClick" Tag="all"
                            Classes.active="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=all}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="全部" /><TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedFgBrush}" Text="{Binding AllCount}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="app-btn seg" Height="28" Click="TabClick" Tag="mirror"
                            Classes.active="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=mirror}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="镜牢" /><TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedFgBrush}" Text="{Binding MirrorCount}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="app-btn seg" Height="28" Click="TabClick" Tag="luxcavation"
                            Classes.active="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=luxcavation}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="经验本" /><TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedFgBrush}" Text="{Binding LuxcavationCount}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="app-btn seg" Height="28" Click="TabClick" Tag="general"
                            Classes.active="{Binding ActiveTab, Converter={StaticResource StrEq}, ConverterParameter=general}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="通用" /><TextBlock FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedFgBrush}" Text="{Binding GeneralCount}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Classes="brand" Height="32" Padding="12,0" Command="{Binding NewTeamCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="＋" VerticalAlignment="Center" />
                        <TextBlock Text="新建队伍" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 队伍卡片列表 -->
        <ScrollViewer Grid.Row="1" Padding="16,12">
            <ItemsControl ItemsSource="{Binding FilteredCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="480" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TeamCardVm">
                        <Border Classes="card" Margin="0,0,8,8" Padding="0">
                            <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <!-- 名称 + 徽章行 -->
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Team.Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,4" />
                                        <Border Classes="badge" Background="{DynamicResource SecondaryBrush}" Height="20" Margin="0,0,6,4">
                                            <TextBlock Text="{Binding Purpose}" FontSize="11" />
                                        </Border>
                                        <Border Classes="badge" Height="20" Margin="0,0,6,4" Background="{DynamicResource BgBrush}"
                                                BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Image Source="{Binding Team.AccessoryScheme, Converter={StaticResource SchemeIcon}}" Width="14" Height="14" />
                                                <TextBlock Text="{Binding Scheme}" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <!-- 元信息行 -->
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding MemberCountText}" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" Margin="0,0,8,3" />
                                        <TextBlock Text="✨ 星光已配" FontSize="11" FontFamily="{StaticResource MonoFont}" Margin="0,0,8,3"
                                                   Foreground="#F59E0B" IsVisible="{Binding HasStarlight}" />
                                        <Border Classes="badge" Height="18" Padding="5,1" Margin="0,0,6,3" IsVisible="{Binding HasSecondSystem}">
                                            <TextBlock Text="第二体系" FontSize="10" />
                                        </Border>
                                        <Border Classes="badge" Height="18" Padding="5,1" Margin="0,0,6,3" IsVisible="{Binding HasSoloPass}">
                                            <TextBlock Text="良秀单通" FontSize="10" Foreground="{DynamicResource BrandBrush}" />
                                        </Border>
                                        <Border Classes="badge" Height="18" Padding="5,1" Margin="0,0,6,3" IsVisible="{Binding HasTeamCode}">
                                            <TextBlock Text="编队码" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                                        </Border>
                                        <Border Classes="badge" Height="18" Padding="5,1" Margin="0,0,6,3" IsVisible="{Binding HasDiscard}">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource DestructiveBrush}">
                                                <Run Text="舍弃 ×" /><Run Text="{Binding DiscardCount}" />
                                            </TextBlock>
                                        </Border>
                                        <Border Classes="badge" Height="18" Padding="5,1" Margin="0,0,0,3" IsVisible="{Binding Disabled}">
                                            <TextBlock Text="已停用" FontSize="10" Foreground="{DynamicResource MutedFgBrush}" />
                                        </Border>
                                    </WrapPanel>
                                    <!-- 人格标签 -->
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="badge" Margin="0,0,6,5" Background="{DynamicResource BgBrush}"
                                                        BorderThickness="1" BorderBrush="{DynamicResource InputBorderBrush}" Height="20">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <TextBlock Text="#" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                   Foreground="{DynamicResource BrandBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Index}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                                   Foreground="{DynamicResource BrandBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                    <Button Classes="app-btn icon-btn" Content="✎" ToolTip.Tip="编辑队伍"
                                            Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).EditTeamCommand}"
                                            CommandParameter="{Binding Team}" />
                                    <Button Classes="app-btn icon-btn danger-ghost" Content="🗑" ToolTip.Tip="删除"
                                            Command="{Binding $parent[UserControl].((vm:TeamsViewModel)DataContext).AskDeleteCommand}"
                                            CommandParameter="{Binding Team}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态（对应 React EmptyState） -->
        <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8" Margin="24">
            <TextBlock Text="👥" FontSize="32" HorizontalAlignment="Center" Opacity="0.45" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyDescription}" FontSize="11"
                       Foreground="{DynamicResource MutedFgBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 删除确认弹窗 -->
        <Border Grid.Row="1" Background="#80000000" IsVisible="{Binding DeleteTarget, Converter={StaticResource NullVis}}">
            <Border Classes="card" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="删除队伍" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedFgBrush}" TextWrapping="Wrap">
                        <Run Text="确定删除队伍“" /><Run Text="{Binding DeleteTarget.Name, Mode=OneWay}" /><Run Text="”吗？此操作不可撤销。" />
                    </TextBlock>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                        <Button Grid.Column="1" Classes="app-btn outline" Height="30" Content="取消" Margin="0,0,8,0"
                                Command="{Binding CancelDeleteCommand}" />
                        <Button Grid.Column="2" Classes="destructive" Height="30" Padding="14,0" Content="删除"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
