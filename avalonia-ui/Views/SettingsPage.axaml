<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls"
             xmlns:vm="clr-namespace:AhabAssistant.Avalonia.ViewModels"
             xmlns:services="clr-namespace:AhabAssistant.Avalonia.Services"
             xmlns:c="clr-namespace:AhabAssistant.Avalonia.Converters"
             x:Class="AhabAssistant.Avalonia.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Resources>
        <c:StringEqualsConv x:Key="StrEq" />
        <c:BoolToVis x:Key="BoolVis" />
        <c:NullToVis x:Key="NullVis" />
        <c:AccentPresetBrush x:Key="AccentPresetBrush" />
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- 页面卡片沿用基础动效层的入场策略；Transitions 负责状态变化时的轻微过渡。 -->
        <Style Selector="Border.card">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" Margin="0,16,0,32" Spacing="12">

            <!-- ============ 1. 外观个性化 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观" FontSize="13" />

                    <!-- 主题模式 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="主题模式" FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource MutedBrush}" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="app-btn seg" Content="浅色" Command="{Binding SetThemeModeCommand}" CommandParameter="light"
                                    Classes.active="{Binding ThemeModeLight}" />
                            <Button Classes="app-btn seg" Content="深色" Command="{Binding SetThemeModeCommand}" CommandParameter="dark"
                                    Classes.active="{Binding ThemeModeDark}" />
                                <Button Classes="app-btn seg" Content="跟随系统" Command="{Binding SetThemeModeCommand}" CommandParameter="system"
                                        Classes.active="{Binding ThemeModeSystem}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Separator Margin="0" />

                    <!-- 强调色 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="强调色" FontSize="12" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Accents}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="services:AccentPreset">
                                    <Button Classes="app-btn" Width="24" Height="24" CornerRadius="12" Padding="0"
                                            Background="{Binding LightBrand, Converter={StaticResource AccentPresetBrush}}"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetAccentCommand}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Separator Margin="0" />

                    <!-- 语言 -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="语言 / Language" FontSize="12" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource MutedBrush}" CornerRadius="8" Padding="4">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="app-btn seg" Content="简体中文" Command="{Binding SetLanguageCommand}" CommandParameter="zh-CN"
                                    Classes.active="{Binding IsZhLang}" />
                                <Button Classes="app-btn seg" Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="en-US"
                                        Classes.active="{Binding IsEnLang}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 2. 全局热键 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="全局热键" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="启用全局热键" FontSize="12" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Hotkey.Enabled}" IsCheckedChanged="HotkeySwitchToggled" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="启动 / 停止热键" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Name="CaptureStartStop" Classes="motion-input" MinWidth="130" Height="30" CornerRadius="6"
                                    Background="{DynamicResource BgBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource InputBorderBrush}" Cursor="Hand"
                                    Tapped="CaptureStartStopTapped">
                                <TextBlock Text="{Binding StartStopDisplay}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="app-btn" Height="26" Padding="8,0" FontSize="11"
                                    Foreground="{DynamicResource MutedFgBrush}" Content="清除" Click="ClearStartStop" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="暂停 / 继续热键" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Border Name="CapturePauseResume" Classes="motion-input" MinWidth="130" Height="30" CornerRadius="6"
                                    Background="{DynamicResource BgBrush}" BorderThickness="1"
                                    BorderBrush="{DynamicResource InputBorderBrush}" Cursor="Hand"
                                    Tapped="CapturePauseResumeTapped">
                                <TextBlock Text="{Binding PauseResumeDisplay}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Button Classes="app-btn" Height="26" Padding="8,0" FontSize="11"
                                    Foreground="{DynamicResource MutedFgBrush}" Content="清除" Click="ClearPauseResume" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 3. 模拟器与连接设置 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="模拟器设置" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="使用模拟器模式" FontSize="12" />
                            <TextBlock Text="启用模拟器 ADB 自动化控制连接" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.Simulator}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>

                    <controls:MotionVisibility IsShown="{Binding ShowSimulatorOptions}" Mode="Reveal">
                    <StackPanel Spacing="14">
                        <Separator Margin="0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="模拟器类型" FontSize="12" />
                                <TextBlock Text="选择当前运行的安卓模拟器" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Classes="app-select" Width="170" SelectedIndex="{Binding SimulatorTypeIndex}" SelectionChanged="SimTypeChanged">
                                <ComboBoxItem>MuMu 模拟器 (推荐)</ComboBoxItem>
                                <ComboBoxItem>其他模拟器</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ADB 端口号" FontSize="12" />
                                <TextBlock Text="模拟器连接端口 (MuMu 默认 16384)" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="app-input" Width="110" Height="30" TextAlignment="Right"
                                     Text="{Binding Sys.SimulatorPort}" LostFocus="PortLostFocus" />
                        </Grid>
                        <controls:MotionVisibility IsShown="{Binding ShowMuMuTimeout}" Mode="Reveal">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="启动模拟器超时 (秒)" FontSize="12" />
                                <TextBlock Text="仅限 MuMu 模拟器拉起等待时间" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Classes="app-input" Width="110" Height="30" TextAlignment="Right"
                                     Text="{Binding Sys.StartEmulatorTimeout}" LostFocus="TimeoutLostFocus" />
                        </Grid>
                        </controls:MotionVisibility>
                    </StackPanel>
                    </controls:MotionVisibility>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 4. 系统与防护设置 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="系统与防护" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="内存占用保护" FontSize="12" />
                            <TextBlock Text="电脑总内存占用超过 90% 时自动清理内存防崩溃" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.MemoryProtection}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最小化到托盘" FontSize="12" />
                            <TextBlock Text="窗口最小化时隐藏到系统托盘区" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.MinimizeToTray}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机自动启动" FontSize="12" />
                            <TextBlock Text="跟随 Windows 系统开机自启 AALC" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.Autostart}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 5. 实验性功能 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="实验性功能" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="运行时阻止休眠" FontSize="12" />
                            <TextBlock Text="任务执行期间阻止系统与显示器进入休眠，任务结束后自动恢复" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.ExperimentalKeepScreenAwake}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="显示器 HDR 检测提示" FontSize="12" />
                            <TextBlock Text="检测到游戏处于 HDR 显示器时提示潜在图像识别问题" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.ExperimentalHdrWarning}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 6. 更新源与 Mirror 酱 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="更新与源配置" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="参与预览版渠道" FontSize="12" />
                            <TextBlock Text="接收测试版与预发布版更新推送" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="compact" IsChecked="{Binding Sys.UpdatePrereleaseEnable}" IsCheckedChanged="SysSwitchToggled" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="更新源选择" FontSize="12" />
                            <TextBlock Text="选择检查与下载更新使用的镜像服务" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Classes="app-select" Width="140" Name="UpdateSourceCombo" SelectionChanged="UpdateSourceChanged">
                            <ComboBoxItem>GitHub</ComboBoxItem>
                            <ComboBoxItem>Mirror 酱</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <controls:MotionVisibility IsShown="{Binding ShowMirrorChyanCdk}" Mode="Reveal">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Mirror 酱 CDK" FontSize="12" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="app-input" Width="230" PlaceholderText="输入 Mirror 酱 CDK (选填)"
                                 Text="{Binding Sys.MirrorchyanCdk}" LostFocus="CdkLostFocus" />
                    </Grid>
                    </controls:MotionVisibility>
                    <Button Classes="app-btn outline" Height="30" HorizontalContentAlignment="Left" Command="{Binding CheckUpdateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:AppIcon Icon="search" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="检查更新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <!-- ============ 7. 关于 ============ -->
            <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
            <Border Classes="card" Padding="14">
                <StackPanel Spacing="12">
                    <TextBlock Text="关于" FontSize="13" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="版本" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{DynamicResource MutedFgBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Margin="0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="开源地址" FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="app-btn" Height="26" Padding="8,0" FontSize="11"
                                Command="{Binding OpenRepoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="GitHub" /><controls:AppIcon Icon="external-link" Width="13" Height="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            </controls:MotionVisibility>

            <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource MutedFgBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
