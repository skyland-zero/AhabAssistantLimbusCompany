<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls"
        x:Class="AhabAssistant.Avalonia.Views.TeamEditWindow"
        Title="编辑队伍"
        Width="768" Height="620" MinWidth="600" MinHeight="420" MaxWidth="768"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowDecorations="None"
        KeyDown="OnKeyDown">

    <Border Classes="dialog-surface" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                    Padding="24,20,24,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Name="TitleText" Text="新建队伍" FontSize="16" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="app-btn outline" Height="28" FontSize="12" Padding="10,0" Click="OnCopyJson">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:AppIcon Icon="copy" Width="13" Height="13" />
                            <TextBlock Text="复制配置 (JSON)" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="app-btn dialog-close" Margin="8,0,0,0"
                            ToolTip.Tip="关闭" Click="OnCancel">
                        <controls:AppIcon Icon="x" Width="13" Height="13" Stroke="{DynamicResource MutedFgBrush}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Tab 选择 -->
            <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="24,8">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="app-btn seg" Name="TabBasic" Tag="basic" Content="基础编成" Click="OnTab" />
                    <Button Classes="app-btn seg" Name="TabShop" Tag="shop" Content="商店与合成" Click="OnTab" />
                    <Button Classes="app-btn seg" Name="TabCombat" Tag="combat" Content="二体系与战斗" Click="OnTab" />
                    <Button Classes="app-btn seg" Name="TabStarlight" Tag="starlight" Content="开局星光" Click="OnTab" />
                    <Button Classes="app-btn seg" Name="TabAdvanced" Tag="advanced" Content="观测与高级" Click="OnTab" />
                </StackPanel>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="2" Padding="24,16">
                <ContentControl Name="TabHost" />
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource TabBarBrush}" Padding="24,12">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Grid.Column="1" Classes="app-btn" Height="32" FontSize="12" Content="取消" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Grid.Column="2" Classes="app-btn brand" Height="32" FontSize="12" Padding="12,0" Content="保存" Click="OnSave" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
