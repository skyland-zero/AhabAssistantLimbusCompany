<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AhabAssistant.Avalonia.Views.TeamEditWindow"
        Title="编辑队伍"
        Width="820" Height="640" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="24,18,24,10">
            <TextBlock Grid.Column="0" Name="TitleText" Text="新建队伍" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="app-btn outline" Height="28" Padding="10,0" Content="⧉ 复制配置 (JSON)" Click="OnCopyJson" />
        </Grid>

        <!-- Tab 选择 -->
        <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource InputBorderBrush}" Padding="24,8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="app-btn seg" Name="TabBasic" Tag="basic" Content="基础编成" Click="OnTab" />
                <Button Classes="app-btn seg" Name="TabShop" Tag="shop" Content="商店与合成" Click="OnTab" />
                <Button Classes="app-btn seg" Name="TabCombat" Tag="combat" Content="二体系与战斗" Click="OnTab" />
                <Button Classes="app-btn seg" Name="TabStarlight" Tag="starlight" Content="开局星光" Click="OnTab" />
                <Button Classes="app-btn seg" Name="TabAdvanced" Tag="advanced" Content="观测与高级" Click="OnTab" />
            </StackPanel>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="2" Padding="24,16">
            <ContentControl Name="TabHost" />
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource InputBorderBrush}"
                Background="{DynamicResource CardBrush}" Padding="24,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="1" Classes="app-btn" Height="30" Content="取消" Margin="0,0,8,0" Click="OnCancel" />
                <Button Grid.Column="2" Classes="brand" Height="30" Padding="16,0" Content="保存" Click="OnSave" />
            </Grid>
        </Border>
    </Grid>
</Window>
