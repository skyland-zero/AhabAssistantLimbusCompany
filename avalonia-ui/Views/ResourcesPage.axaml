<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls"
             xmlns:vm="clr-namespace:AhabAssistant.Avalonia.ViewModels"
             xmlns:c="clr-namespace:AhabAssistant.Avalonia.Converters"
             xmlns:models="clr-namespace:AhabAssistant.Avalonia.Models"
             x:Class="AhabAssistant.Avalonia.Views.ResourcesPage"
             x:DataType="vm:ResourcesViewModel"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <c:NullToVis x:Key="NullVis" />
        <c:NullToVis x:Key="NullVisInv" Invert="True" />
        <c:StringEqualsConv x:Key="StrEq" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部操作栏 -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource InputBorderBrush}" Padding="20,10">
            <Border.Background>
                <DynamicResource ResourceKey="TabBarBrush" />
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <controls:MotionVisibility Classes="motion-state" IsShown="{Binding SyncProgress, Converter={StaticResource NullVis}}" Mode="Fade">
                    <Border Classes="badge" Height="20">
                        <TextBlock Text="{Binding SyncText}" FontSize="11" Classes="status-label" FontFamily="{StaticResource MonoFont}" />
                    </Border>
                    </controls:MotionVisibility>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="app-btn outline" Height="28" Padding="10,0" Command="{Binding CheckUpdateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:AppIcon Icon="search" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="检查更新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="app-btn brand motion-action" Height="28" Padding="10,0" Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding SyncButtonEnabled}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:AppIcon Icon="refresh-cw" Width="14" Height="14" Stroke="{DynamicResource BrandFgBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="立即同步" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 资源分组卡片 -->
        <ScrollViewer Grid.Row="1" Padding="24,16">
            <ItemsControl Name="ResourceItems" Classes="motion-list motion-stagger-8" ItemsSource="{Binding Groups}" MaxWidth="768" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="372" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ResourceGroup">
                        <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
                        <Border Classes="card" Margin="0,0,12,12" Padding="20">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                                </Transitions>
                            </Border.Transitions>
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" Classes="card-title" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Classes="status-label" Foreground="{DynamicResource FgBrush}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="本地版本" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" Margin="0,0,16,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LocalVersion}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="远端版本" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" Margin="0,0,16,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RemoteVersionText}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="上次同步" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastSyncText}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                                </Grid>
                                <!-- 同步时显示与 React 版本一致的进度条 -->
                                <controls:MotionVisibility Classes="motion-progress" IsShown="{Binding $parent[UserControl].((vm:ResourcesViewModel)DataContext).SyncProgress, Converter={StaticResource NullVis}}" Mode="Fade">
                                <ProgressBar Value="{Binding $parent[UserControl].((vm:ResourcesViewModel)DataContext).SyncProgress}"
                                             Maximum="100" Height="4" Margin="0,3,0,0">
                                    <ProgressBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Value" Duration="0:0:0.22" />
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                                        </Transitions>
                                    </ProgressBar.Transitions>
                                </ProgressBar>
                                </controls:MotionVisibility>
                            </StackPanel>
                        </Border>
                        </controls:MotionVisibility>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
