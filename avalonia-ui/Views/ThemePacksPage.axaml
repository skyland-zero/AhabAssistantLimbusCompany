<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls"
             xmlns:vm="clr-namespace:AhabAssistant.Avalonia.ViewModels"
             xmlns:c="clr-namespace:AhabAssistant.Avalonia.Converters"
             x:Class="AhabAssistant.Avalonia.Views.ThemePacksPage"
             x:DataType="vm:ThemePacksViewModel">
    <UserControl.Resources>
        <c:EnabledOpacity x:Key="EnabledOpacity" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 顶部操作栏 -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource InputBorderBrush}" Padding="20,10">
            <Border.Background>
                <DynamicResource ResourceKey="TabBarBrush" />
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="总权重：" FontSize="12" Foreground="{DynamicResource MutedFgBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalWeight}" FontSize="12" Classes="status-label"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="app-btn outline" Height="28" Padding="10,0" Command="{Binding ToggleSortCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:AppIcon Icon="arrow-up-down" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="按权重排序" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="app-btn outline" Height="28" Padding="10,0" Content="全部启用" Command="{Binding EnableAllCommand}" />
                    <Button Classes="app-btn outline" Height="28" Padding="10,0" Content="全部停用" Command="{Binding DisableAllCommand}" />
                    <Button Classes="app-btn" Height="28" Padding="10,0" Foreground="{DynamicResource MutedFgBrush}" Command="{Binding ResetWeightsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <controls:AppIcon Icon="rotate-ccw" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="恢复默认权重" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 困难镜牢提示条 -->
            <controls:MotionVisibility Grid.Row="1" Classes="motion-state"
                                       IsShown="{Binding HardMirrorBannerVisible}" Mode="Fade">
            <Border Background="{DynamicResource WarningLightBrush}" Padding="24,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:AppIcon Icon="triangle-alert" Width="15" Height="15" Stroke="{DynamicResource WarningBrush}" />
                <TextBlock Text="困难镜牢周期进行中：建议优先筛选高星主题包并提高其权重" FontSize="12"
                           Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>
            </Border>
            </controls:MotionVisibility>

        <!-- 主题包列表 -->
        <ScrollViewer Grid.Row="2" Padding="24,16">
            <ItemsControl Classes="motion-list motion-stagger-8" ItemsSource="{Binding Packs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PackCardVm">
                        <controls:MotionVisibility Classes="motion-item motion-card" IsShown="True" Mode="Slide">
                        <Border Classes="card" Margin="0,0,0,8"
                                Opacity="{Binding Enabled, Converter={StaticResource EnabledOpacity}}">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,180,*,Auto" Margin="20,12">
                                <ToggleSwitch Grid.Column="0" Classes="compact" IsChecked="{Binding Enabled}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Classes="card-title"
                                               MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                    <Border Classes="badge"><TextBlock Text="{Binding Tier}" FontSize="11" Classes="status-label" /></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="权重" FontSize="11" Foreground="{DynamicResource MutedFgBrush}" />
                                    <Slider Width="220" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                           Value="{Binding Weight}" IsEnabled="{Binding Enabled}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WeightText}" Width="24" TextAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </controls:MotionVisibility>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
