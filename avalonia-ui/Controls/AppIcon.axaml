<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls"
             x:Class="AhabAssistant.Avalonia.Controls.AppIcon"
             x:DataType="controls:AppIcon"
             x:Name="Root"
             Width="16"
             Height="16"
             IsHitTestVisible="False"
             UseLayoutRounding="True">
    <Viewbox Stretch="Uniform" UseLayoutRounding="True">
        <Canvas Width="24" Height="24">
            <Path Data="{Binding #Root.IconGeometry}"
                  Fill="Transparent"
                  Stroke="{Binding #Root.Stroke}"
                  StrokeThickness="{Binding #Root.StrokeThickness}"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
