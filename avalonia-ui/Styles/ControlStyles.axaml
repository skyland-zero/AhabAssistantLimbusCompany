<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:AhabAssistant.Avalonia.Controls">
    <!-- 全局文本：对应 Web UI 的 body foreground / font-family -->
    <Style Selector="Window">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="SelectableTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Card：Web Card 默认无边框，依靠卡片色与页面背景分层 -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- DialogContent：对应 Web Dialog 的 bg-background / rounded-lg / p-6 -->
    <Style Selector="Border.dialog-surface">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BoxShadow" Value="0 10 25 0 #40000000" />
    </Style>

    <!-- 页面内嵌分区：对应 Web UI 的 bg-card/20 + border-border/60 -->
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.app-btn.dialog-close">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    </Style>

    <!-- Button 基础模板：源码自有，避免依赖第三方组件库的视觉模板 -->
    <Style Selector="Button.app-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.app-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="Button.app-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button.app-btn:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.app-btn:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- outline -->
    <Style Selector="Button.app-btn.outline">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.app-btn.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>

    <!-- ghost -->
    <Style Selector="Button.app-btn.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- brand -->
    <Style Selector="Button.app-btn.brand">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.app-btn.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
    </Style>

    <!-- destructive -->
    <Style Selector="Button.app-btn.destructive">
        <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DestructiveFgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.app-btn.destructive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DestructiveBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.app-btn.danger-ghost">
        <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}" />
    </Style>

    <!-- 图标按钮 -->
    <Style Selector="Button.app-btn.icon-btn">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.app-btn.icon-btn.active">
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
    </Style>
    <Style Selector="Button.app-btn.icon-btn.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>

    <!-- 自绘标题栏 -->
    <Style Selector="Button.app-btn.titlebar-btn">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.app-btn.titlebar-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.app-btn.titlebar-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- 主导航 -->
    <Style Selector="Button.nav-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav-tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab controls|AppIcon">
        <Setter Property="Stroke" Value="{DynamicResource MutedFgBrush}" />
    </Style>

    <Style Selector="Button.nav-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab:pointerover controls|AppIcon">
        <Setter Property="Stroke" Value="{DynamicResource FgBrush}" />
    </Style>

    <Style Selector="Button.nav-tab.active">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-tab.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-tab.active controls|AppIcon">
        <Setter Property="Stroke" Value="{DynamicResource BrandFgBrush}" />
    </Style>

    <Style Selector="Button.nav-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab.active:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandFgBrush}" />
    </Style>
    <Style Selector="Button.nav-tab.active:pointerover controls|AppIcon">
        <Setter Property="Stroke" Value="{DynamicResource BrandFgBrush}" />
    </Style>

    <!-- 分段控件：对应 TabsList + TabsTrigger -->
    <Style Selector="Button.app-btn.seg">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MutedFgBrush}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.app-btn.seg.active">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.app-btn.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}" />
    </Style>
    <Style Selector="Button.app-btn.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>

    <!-- Badge：对应 shadcn Badge 的 rounded-full -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 表单控件：对应 Input h-9 / Select h-9 -->
    <Style Selector="TextBox.app-input">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBox.app-input:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}" />
    </Style>
    <Style Selector="TextBox.app-input:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="ComboBox.app-select">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="ComboBox.app-select:pointerover">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}" />
    </Style>
    <Style Selector="ComboBox.app-select:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource RingBrush}" />
    </Style>

    <!-- Toggle / Slider -->
    <Style Selector="ToggleSwitch.compact">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Border#PART_SwitchContainer">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="18" />
    </Style>
    <Style Selector="ToggleSwitch.compact:checked /template/ Border#PART_SwitchContainer">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.compact /template/ Ellipse#PART_SwitchKnob">
        <Setter Property="Fill" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.compact:off /template/ Border#PART_SwitchContainer">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource BrandBrush}" />
    </Style>

    <!-- 低存在感滚动条 -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="Height" Value="1" />
    </Style>
</Styles>
